# Maintainer: Gabriel Vargas Monroy <tu-email@ejemplo.com>
pkgname=telegram-send-py
pkgver=1.0.0
pkgrel=1
pkgdesc="Send and receive Telegram messages through the Bot API, with script triggering"
arch=('any')
url="https://github.com/vmgabriel/telegram-send-py"
license=('MIT')
depends=(
    'python-typer'
    'python-pydantic'
    'python-pydantic-settings'
    'python-platformdirs'
    'python-requests'
    'python-aiosqlite'
)
makedepends=(
    'python-build'
    'python-installer'
    'python-hatchling'
    'git'
)
checkdepends=(
    'python-pytest'
    'python-pytest-cov'
)
optdepends=(
    'groff: for viewing the man page'
)
source=("git+${url}.git#branch=master")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$pkgname"
    git describe --tags --abbrev=0 2>/dev/null | sed 's/^v//' || echo "$pkgver"
}

build() {
    cd "$srcdir/$pkgname"
    # Forzamos el uso del Python del sistema para evitar conflictos con venvs de usuario
    /usr/bin/python -m build --wheel --no-isolation
}

check() {
    cd "$srcdir/$pkgname"
    /usr/bin/python -m pytest tests/ -v
}

package() {
    cd "$srcdir/$pkgname"
    
    # Instalamos el wheel generado
    /usr/bin/python -m installer --destdir="$pkgdir" dist/*.whl
    
    # Instalamos la página de manual
    install -Dm644 extras/telegram-send.1 \
        "$pkgdir/usr/share/man/man1/telegram-send.1"
    gzip -n "$pkgdir/usr/share/man/man1/telegram-send.1"
    
    # Instalamos el servicio systemd de usuario
    install -Dm644 extras/telegram-send.service.example \
        "$pkgdir/usr/lib/systemd/user/telegram-listen.service"
    
    # Instalamos la licencia (estándar de Arch Linux)
    install -Dm644 LICENSE \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    
    # Instalamos la documentación
    install -Dm644 README.md \
        "$pkgdir/usr/share/doc/$pkgname/README.md"
}
